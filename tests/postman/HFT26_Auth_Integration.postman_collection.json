  "item": [
    {
      "name": "01_Student_Authentication",
      "item": [
        {
          "name": "TC_AUTH_STUD_01 - Student Registration (Success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('dynamicStudentEmail', `student_${ts}@cbit.ac.in`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains access_token and student role', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.expect(jsonData.user.role).to.eql('student');",
                  "    pm.collectionVariables.set('studentToken', jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Verma\",\n  \"email\": \"{{dynamicStudentEmail}}\",\n  \"password\": \"SecurePass123!\",\n  \"github_profile\": \"https://github.com/rohan-cbit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/student/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "student", "register"]
            }
          }
        },
        {
          "name": "TC_AUTH_STUD_02 - Student Login (Success)",
          "event": [
