{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeSubmissionSchema",
  "type": "object",
  "required": ["source_code", "language", "question_id", "assessment_id"],
  "properties": {
    "source_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "Candidate code solution"
    },
    "language": {
      "type": "string",
      "enum": ["python", "cpp", "c++", "java"],
      "description": "Programming language"
    },
    "question_id": {
      "type": "string",
      "description": "Question UUID"
    },
    "assessment_id": {
      "type": "string",
      "description": "Assessment session UUID"
    }
  }
}
